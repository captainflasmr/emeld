# Everything under test/ is generated by the scripts in this directory
# (make-example.sh, gen-test-data.sh, bench.sh) except the hand-written
# sources below.  This keeps arbitrary in-tree output directories — the
# default test/example/ fixture as well as any directory passed to
# make-example.sh or gen-test-data.sh — out of the repository.
/*
!/.gitignore
!/*.el
!/*.sh
!/README.org
!/VIDEO-WALKTHROUGH.org
